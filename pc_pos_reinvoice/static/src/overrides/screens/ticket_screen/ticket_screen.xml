<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pc_pos_reinvoice.TicketScreenInherit"
       t-inherit="point_of_sale.TicketScreen"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons')]" position="inside">
            <button class="control-button btn btn-warning btn-lg lh-lg flex-grow-1 flex-shrink-1"
                    t-if="isReinvoiceVisible(_selectedSyncedOrder)"
                    t-on-click="() => this.onClickReinvoice(_selectedSyncedOrder)">
                <i class="fa fa-pencil-square-o me-1"/>
                Refacturar
            </button>
            <button class="control-button btn btn-info btn-lg lh-lg flex-grow-1 flex-shrink-1"
                    t-if="isSendInvoiceEmailVisible(_selectedSyncedOrder)"
                    t-on-click="() => this.onClickSendInvoiceEmail(_selectedSyncedOrder)">
                <i class="fa fa-envelope me-1"/>
                Enviar factura por email
            </button>
        </xpath>
    </t>

</templates>
