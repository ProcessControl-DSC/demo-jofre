<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_config_form_inherit_reinvoice" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.reinvoice</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='other_devices']" position="after">
                <setting id="pos_reinvoice"
                         string="Refacturación POS"
                         help="Permite refacturar pedidos pagados desde el TPV
                               cambiando el cliente. Genera rectificativa y
                               nueva factura, opcionalmente envía la nueva
                               factura por correo al cliente y permite
                               reenviar facturas existentes por correo desde
                               la pantalla de tickets.">
                    <field name="allow_reinvoice"/>
                    <div class="row mt8" invisible="not allow_reinvoice">
                        <div class="col-12">
                            <field name="allow_reinvoice_closed_session"/>
                            <label for="allow_reinvoice_closed_session"/>
                        </div>
                        <div class="col-12">
                            <field name="prompt_email_after_reinvoice"/>
                            <label for="prompt_email_after_reinvoice"/>
                        </div>
                    </div>
                </setting>
                <setting id="pos_send_invoice_email"
                         string="Enviar factura por email"
                         help="Habilita el botón 'Enviar factura por email'
                               en la pantalla de tickets para reenviar la
                               factura de un pedido al correo del cliente.">
                    <field name="allow_send_invoice_email"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
